# GEMINI_API_KEY: Required only if AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Canonical Production Website URL used for distributable QR codes & permanent links
# Optional during local development and Google AI Studio preview (QR downloads & print signage
# remain disabled until a valid HTTPS production domain is set, e.g. https://benmicuborealestate.pages.dev)
VITE_PUBLIC_SITE_URL=""

# ==============================================================================
# CLIENT-SAFE SUPABASE VARIABLES (Bundled into Vite frontend)
# NEVER expose service_role or private keys with VITE_!
# ==============================================================================
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# LOCAL DEVELOPMENT DEMO MODE (Explicit Opt-In Only)
# Must remain "false" or unset in all production and preview deployments.
# Ignored automatically by production/preview builds (import.meta.env.PROD=true).
# ==============================================================================
VITE_ENABLE_DEMO_MODE="false"

